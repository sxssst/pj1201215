<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Profile | Blackdit</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="topbar">
    <a class="wordmark" href="/">Blackdit</a>
    <nav class="top-actions" aria-label="Main navigation"><a href="/">Feed</a><a class="nav-active" href="/profile">Profile</a><% if (currentUser.role === 'admin') { %><a href="/admin">Admin Panel</a><% } %><a class="nav-user" href="/profile"><img src="<%= currentUser.avatar_url || '/avatar-placeholder.svg' %>" alt="" width="30" height="30"><span><%= currentUser.username %></span></a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button" type="submit">Logout</button></form></nav>
  </header>
  <main class="profile-shell profile-page">
    <% if (flash) { %><p class="notice <%= flash.type %>" role="status"><%= flash.message %></p><% } %>
    <p class="eyebrow">YOUR CORNER</p>
    <div class="profile-heading"><div class="profile-avatar"><img class="avatar-image" src="<%= profile.avatar_url || '/avatar-placeholder.svg' %>" alt="Profile picture"></div><div><h1><%= profile.display_name || profile.username %></h1><p class="profile-username">@<%= profile.username %></p><span class="role-label <%= profile.role %>"><%= profile.role %></span><p class="profile-bio"><%= profile.bio || 'No bio yet.' %></p></div></div>
    <div class="profile-grid">
      <section class="profile-editor"><p class="eyebrow">ACCOUNT DETAILS</p><h2>Update Profile</h2><form method="post" action="/profile" enctype="multipart/form-data" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Profile image<input class="profile-image-input" type="file" name="avatar" accept="image/jpeg,image/png,image/gif,image/webp"><small>Choose a JPEG, PNG, GIF, or WebP image up to 5 MB.</small></label><label>Username<input name="username" required minlength="3" maxlength="32" pattern="[A-Za-z0-9_.-]+" value="<%= profile.username %>" autocomplete="username"><small>This is your unique sign-in name.</small></label><label>Display name<input name="display_name" required maxlength="50" value="<%= profile.display_name || profile.username %>" placeholder="Your display name"></label><label>Bio<textarea name="bio" maxlength="500" rows="4" placeholder="Tell the community a little about yourself"><%= profile.bio || '' %></textarea><small>Up to 500 characters.</small></label><div class="form-actions"><button class="button primary" type="submit">Save profile</button></div></form></section>
      <section class="profile-posts"><div class="stream-heading"><h2>Your posts</h2><span class="count"><%= posts.length %></span></div>
        <% if (posts.length === 0) { %><p class="muted">ยังไม่มีโพสต์</p><% } else { %>
          <% posts.forEach(post => { %><article class="profile-post"><time><%= post.created_at %></time><h3><a href="/#post-<%= post.id %>"><%= post.title %></a></h3><p><%= post.content %></p><% if (post.image_url) { %><img class="profile-post-image" src="<%= post.image_url %>" alt="ภาพประกอบโพสต์" loading="lazy"><% } %><form method="post" action="/posts/<%= post.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button danger-link" type="submit">Delete post</button></form></article><% }); %>
        <% } %>
      </section>
    </div>
  </main>
</body>
</html>